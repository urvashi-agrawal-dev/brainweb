
{
  "manifest_version": 3,
  "name": "BrainWeb",
  "version": "0.4.0",
  "description": "Privacy-first content consumption and active-time tracker for X and LinkedIn.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "https://brainweb-dashboard.vercel.app/*"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BrainWeb"
  }
}
